{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wexp:vectors:schema:0.2.0",
  "title": "WEXP implementation-independent vector envelope",
  "description": "Schema for WEXP vector files. Core -00 vectors use an explicitly non-normative test representation; this schema does not define a WEXP wire protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_id",
    "specification",
    "requirement_ids",
    "classification",
    "input",
    "expected"
  ],
  "properties": {
    "vector_id": {
      "type": "string",
      "pattern": "^(WEXP-CORE-00-V[0-9]{4,}|WEXP-EXAMPLE-V[0-9]{4,})$"
    },
    "specification": {
      "oneOf": [
        {"const": "schema-example"},
        {"$ref": "#/$defs/core00Specification"}
      ]
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^WEXP-CORE-00-REQ-[0-9]{4,}$"
      },
      "uniqueItems": true
    },
    "description": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "classification": {
      "enum": [
        "positive",
        "negative",
        "boundary",
        "non-normative-schema-example"
      ]
    },
    "test_representation": {"$ref": "#/$defs/testRepresentation"},
    "input": true,
    "expected": {"type": "object", "minProperties": 1},
    "derivation": {"$ref": "#/$defs/derivation"}
  },
  "$defs": {
    "core00Specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "revision", "artifact", "sha256"],
      "properties": {
        "document": {"const": "draft-sergeev-wexp-core"},
        "revision": {"const": "00"},
        "artifact": {"const": "xml"},
        "sha256": {"const": "6cd8b680059cc81e1ec4c84737d9319ee242ef63e89c57de497bd57ede08d810"}
      }
    },
    "testRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "status"],
      "properties": {
        "id": {"const": "wexp-core-00-test-harness"},
        "revision": {"const": "1"},
        "status": {"const": "non-normative-test-representation"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_locators", "steps"],
      "properties": {
        "source_locators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {"const": "non-normative-schema-example"}
        },
        "required": ["classification"]
      },
      "then": {
        "required": ["description"],
        "properties": {
          "vector_id": {"pattern": "^WEXP-EXAMPLE-V[0-9]{4,}$"},
          "specification": {"const": "schema-example"},
          "requirement_ids": {"maxItems": 0}
        },
        "not": {
          "anyOf": [
            {"required": ["purpose"]},
            {"required": ["test_representation"]},
            {"required": ["derivation"]}
          ]
        }
      },
      "else": {
        "required": ["purpose", "test_representation", "derivation"],
        "properties": {
          "vector_id": {"pattern": "^WEXP-CORE-00-V[0-9]{4,}$"},
          "specification": {"$ref": "#/$defs/core00Specification"},
          "requirement_ids": {"minItems": 1},
          "classification": {"enum": ["positive", "negative", "boundary"]}
        },
        "not": {"required": ["description"]}
      }
    }
  ]
}
